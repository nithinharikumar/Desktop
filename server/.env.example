# Server & Security
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
COOKIE_SECRET=change_this_to_a_secure_random_secret_at_least_32_chars!

# Database (PostgreSQL hosted e.g. Neon or Supabase)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local Storage (Zero S3 dependency)
UPLOAD_DIR="./uploads"

# Thresholds & Constraints
MIN_FILE_BYTES=51200
MIN_WIDTH=640
MIN_HEIGHT=640
BLUR_THRESHOLD=100
MIN_FACE_AREA_RATIO=0.05
SIMILARITY_MAX_DISTANCE=5
MAX_UPLOAD_BYTES=15728640
CONCURRENCY=3
